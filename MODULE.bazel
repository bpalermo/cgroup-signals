module(
    name = "cgroup-signals",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_img", version = "0.3.23")

# Named by //bazel/image for string_flag, and already in the graph through
# rules_img and rules_go; declared so a bump of those cannot drop it.
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# sh_library and sh_test for the scripts under //bazel.
bazel_dep(name = "rules_shell", version = "0.8.0")

# Formatting and the linters that are not part of compiling: //bazel/format
# formats and checks Starlark (buildifier, with its lint warnings), Go and
# shell; //bazel/lint has the shellcheck and gocognit aspects.
bazel_dep(name = "aspect_rules_lint", version = "2.9.1")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")

# Helm, for chart/cgroup-signals: packaged, linted, rendered and pushed by Bazel.
bazel_dep(name = "rules_helm", version = "0.33.0")

helm = use_extension("@rules_helm//helm:extensions.bzl", "helm")

# Pinned, not rules_helm's default, so a rules_helm bump does not move helm
# with it. The toolchains follow the same pin in .bazelrc
# (@rules_helm//helm/settings:version): helm.toolchain takes no version.
helm.host_tools(version = "4.2.0")
use_repo(helm, "helm", "helm_toolchains")

register_toolchains("@helm_toolchains//:all")

# The eBPF programs (//bpf): compiled by clang from toolchains_llvm, the LLVM
# release for the machine Bazel runs on (linux amd64 or arm64), used only as a
# compiler for //bazel/bpf:defs.bzl; no C++ toolchain is registered, so nothing
# else changes. libbpf is only its headers (bpf_helpers.h, bpf_core_read.h,
# bpf_tracing.h); the vmlinux.h is checked in (bpf/vmlinux.h).
bazel_dep(name = "toolchains_llvm", version = "1.13.0")
bazel_dep(name = "libbpf", version = "1.7.0.bcr.2")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")

# 20.1.8: the newest LLVM 20 release, with prebuilt linux amd64 and arm64.
llvm.toolchain(llvm_version = "20.1.8")
use_repo(llvm, "llvm_toolchain_llvm")

# The Go toolchain, pinned here rather than read from go.mod: go.mod's `go`
# line is the language version the module requires, this is the exact SDK
# every build compiles with. Bump both together; the SDK must not be older
# than the `go` line.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.2")

# Static analysis, run as part of compiling every Go package of this module
# (and of none of its dependencies): a finding fails the build. //:nogo says
# which analyzers.
go_sdk.nogo(nogo = "//:nogo")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "co_honnef_go_tools", "com_github_calebq42_squashfs", "com_github_cilium_ebpf", "com_github_prometheus_client_golang", "com_github_prometheus_client_model", "com_github_uudashr_gocognit", "in_yaml_go_yaml_v3", "org_golang_x_sys")

# Container image base: distroless static on Debian 13, nonroot variant (user
# 65532), pinned by index digest so a moving tag cannot change the image.
# Resolved from gcr.io/distroless/static-debian13:nonroot. Layers are fetched
# lazily, only when an image is loaded, so `bazel build //...` needs no
# registry access and no Docker daemon.
pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

pull(
    name = "distroless_static",
    digest = "sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3",
    layer_handling = "lazy",
    registry = "gcr.io",
    repository = "distroless/static-debian13",
)

# The debug variant of the same base (busybox at /busybox/sh, root by default)
# for the bpftrace image, which people exec into. Resolved from
# gcr.io/distroless/static-debian13:debug, pinned by index digest.
pull(
    name = "distroless_static_debug",
    digest = "sha256:ebd32759877244c6e72c1610b6fb1cd1004625cc575361ee2ae0b79df9eb3893",
    layer_handling = "lazy",
    registry = "gcr.io",
    repository = "distroless/static-debian13",
)

# bpftrace v0.27.1, the upstream release assets (sha256 as GitHub records them
# in the release API). They are Nix-built AppImages, not static binaries: a
# static runtime plus a squashfs of the program and its /nix/store closure.
# //appimage-closure unpacks them at build time (see //bpftrace).
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "bpftrace_aarch64",
    sha256 = "ad159222808d799eaa85424001535836314cf21977a71686b7b7c091b5195672",
    urls = ["https://github.com/bpftrace/bpftrace/releases/download/v0.27.1/bpftrace-aarch64"],
)

http_file(
    name = "bpftrace_x86_64",
    sha256 = "c8d570302725bd1a3ed2f23bfa8d83dd78bde95daa98856279343052db5799c9",
    urls = ["https://github.com/bpftrace/bpftrace/releases/download/v0.27.1/bpftrace-x86_64"],
)

# bpftool v7.8.1 from libbpf/bpftool: statically linked release binaries.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "bpftool_arm64",
    build_file_content = 'exports_files(["bpftool"])',
    sha256 = "678cc6fdc545f6baf9fc80bbca3ab4cb0efcd3f4d814c6fada00ca0987a4c6b0",
    urls = ["https://github.com/libbpf/bpftool/releases/download/v7.8.1/bpftool-v7.8.1-arm64.tar.gz"],
)

http_archive(
    name = "bpftool_amd64",
    build_file_content = 'exports_files(["bpftool"])',
    sha256 = "112026bbdf48d0d00ccfc4926e59878d47943f97c197f959f110abe29c898ddc",
    urls = ["https://github.com/libbpf/bpftool/releases/download/v7.8.1/bpftool-v7.8.1-amd64.tar.gz"],
)
