load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_img//img:image.bzl", "image_index", "image_manifest")
load("@rules_img//img:layer.bzl", "file_metadata", "image_layer", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img//img:push.bzl", "image_push")
load("//bazel:registry.bzl", "IMAGE_REGISTRY", "image_repository")
load("//bazel/image:defs.bzl", "DEFAULT_PLATFORMS")

# ghcr.io/bpalermo/cgroup-signals-bpftrace: bpftrace v0.27.1 (and its upstream
# tools/*.bt) and bpftool v7.8.1 on the distroless static DEBUG base (a shell,
# at /busybox/sh), for the bpftrace-debug chart. See README.md, "Debug pod".
#
# bpftrace's release asset is a Nix-built AppImage: it needs FUSE or a user
# namespace to run, and a user namespace has no CAP_BPF in the host's. So the
# image holds what is inside it, unpacked at build time by //appimage-closure:
# the program and the shared libraries it loads (libLLVM, libclang, glibc, ...)
# at /nix/store, exactly where its interpreter and run paths expect them.
config_setting(
    name = "arm64",
    constraint_values = ["@platforms//cpu:aarch64"],
)

config_setting(
    name = "amd64",
    constraint_values = ["@platforms//cpu:x86_64"],
)

[
    genrule(
        name = "closure_" + arch,
        srcs = ["@bpftrace_%s//file" % arch],
        outs = ["closure_%s.tar" % arch],
        cmd = " ".join([
            "$(execpath //appimage-closure)",
            "-appimage $<",
            "-out $@",
            # The program on PATH, and the upstream tools where bpftrace's docs say.
            "-link usr/local/bin/bpftrace=@entry",
            "-link usr/share/bpftrace/tools=@root/share/bpftrace/tools",
        ]),
        tools = ["//appimage-closure"],
    )
    for arch in [
        "aarch64",
        "x86_64",
    ]
]

[
    layer_from_tar(
        name = "bpftrace_layer_" + arch,
        src = ":closure_" + arch,
        compress = "zstd",
    )
    for arch in [
        "aarch64",
        "x86_64",
    ]
]

image_layer(
    name = "bpftool_layer",
    srcs = select({
        ":amd64": {"/usr/local/bin/bpftool": "@bpftool_amd64//:bpftool"},
        ":arm64": {"/usr/local/bin/bpftool": "@bpftool_arm64//:bpftool"},
    }),
    compress = "zstd",
    default_metadata = file_metadata(mode = "0755"),
    include_runfiles = False,
)

string_flag(
    name = "image_tag",
    build_setting_default = "dev",
    visibility = ["//visibility:public"],
)

image_manifest(
    name = "image_manifest",
    base = "@distroless_static_debug",
    entrypoint = ["/usr/local/bin/bpftrace"],
    labels = {
        "org.opencontainers.image.source": "https://github.com/bpalermo/cgroup-signals",
        "org.opencontainers.image.description": "bpftrace and bpftool for the bpftrace-debug chart (on-demand debug pod)",
        "org.opencontainers.image.licenses": "Apache-2.0",
    },
    layers = select({
        ":amd64": [
            ":bpftrace_layer_x86_64",
            ":bpftool_layer",
        ],
        ":arm64": [
            ":bpftrace_layer_aarch64",
            ":bpftool_layer",
        ],
    }),
    # Root: bpf(2) and the tracefs files need it, with the pod's privileges.
    user = "0",
)

image_index(
    name = "image_index",
    manifests = [":image_manifest"],
    platforms = DEFAULT_PLATFORMS,
    visibility = ["//visibility:public"],
)

image_load(
    name = "image_load",
    image = ":image_index",
    tag = "localhost/cgroup-signals-bpftrace:dev",
    visibility = ["//visibility:public"],
)

# The same two tags as //cgroup-signals:image_push (see //bazel/image:defs.bzl).
image_push(
    name = "image_push",
    build_settings = {"tag": ":image_tag"},
    image = ":image_index",
    registry = IMAGE_REGISTRY,
    repository = image_repository("cgroup-signals-bpftrace"),
    tag_list = [
        "{{.tag}}",
        "{{if .STABLE_GIT_COMMIT}}{{.tag}}-{{.STABLE_GIT_COMMIT}}{{end}}",
    ],
    visibility = ["//visibility:public"],
)
