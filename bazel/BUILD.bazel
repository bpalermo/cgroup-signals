load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The publishing coordinates (registry.bzl), the git state that stamps the
# images' tags and the binary's version (workspace_status.sh).
exports_files([
    "registry.bzl",
    "workspace_status.sh",
    # Run by the publish workflow, between building the chart and pushing it.
    "verify-chart.sh",
])

# For the shellcheck aspect (--config=lint): the workspace status script is
# run by Bazel itself and the rest are run by people and workflows, so no
# target would otherwise show them to the aspect.
sh_library(
    name = "scripts",
    srcs = glob(["*.sh"]),
)

sh_test(
    name = "workspace_status_test",
    size = "small",
    srcs = ["workspace_status_test.sh"],
    data = ["workspace_status.sh"],
)

# The decision of ci-impacted-targets.sh (the `diff` job of ci.yml): which
# impacted targets CI builds and tests, on fixture lists.
sh_test(
    name = "ci_impacted_targets_test",
    size = "small",
    srcs = ["ci_impacted_targets_test.sh"],
    data = ["ci-impacted-targets.sh"],
)

# What the publish workflow checks on the packaged chart before it pushes.
sh_test(
    name = "verify_chart_test",
    size = "small",
    srcs = ["verify_chart_test.sh"],
    args = ["$(rootpath verify-chart.sh)"],
    data = ["verify-chart.sh"],
)
