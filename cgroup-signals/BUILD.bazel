load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel:registry.bzl", "IMAGE_REGISTRY", "image_repository")
load("//bazel/image:defs.bzl", "go_image")

go_library(
    name = "cgroup-signals_lib",
    srcs = ["main.go"],
    importpath = "github.com/bpalermo/cgroup-signals/cgroup-signals",
    visibility = ["//visibility:private"],
    deps = [
        "//cgroup-signals/internal/server",
        "//common/version",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_prometheus_client_golang//prometheus/collectors",
    ],
)

go_binary(
    name = "cgroup-signals",
    basename = "cgroup-signals",
    embed = [":cgroup-signals_lib"],
    # Pure Go: the image binary is cross-built for linux with cgo off.
    pure = "on",
    visibility = ["//visibility:public"],
)

go_image(
    name = "image",
    base = "@distroless_static",
    binary = ":cgroup-signals",
    labels = {
        # Links the package on ghcr.io to this repository.
        "org.opencontainers.image.source": "https://github.com/bpalermo/cgroup-signals",
        "org.opencontainers.image.description": "Per-cgroup kernel signals (memory peak, PSI, run-queue latency) as Prometheus metrics",
        "org.opencontainers.image.licenses": "Apache-2.0",
    },
    load_tag = "localhost/cgroup-signals:dev",
    path = "/cgroup-signals",
    registry = IMAGE_REGISTRY,
    repository = image_repository("cgroup-signals"),
    # Root: the cgroup files (memory.peak, the PSI triggers) and the BPF
    # programs need CAP_SYS_ADMIN/CAP_BPF, which the runtime grants the
    # container's process only as uid 0 in a privileged DaemonSet.
    user = "0",
)
